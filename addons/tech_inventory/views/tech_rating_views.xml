<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tech_rating_list" model="ir.ui.view">
        <field name="name">tech.rating.list</field>
        <field name="model">tech.rating</field>
        <field name="arch" type="xml">
            <list string="Valoraciones de los Equipos Tecnológicos">
                <field name="name"/>
                <field name="rating"/>
                <field name="evaluated_by_id"/>
                <field name="is_recommended"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_tech_rating_form" model="ir.ui.view">
        <field name="name">tech.rating.form</field>
        <field name="model">tech.rating</field>
        <field name="arch" type="xml">
            <form string="Valoracion">
                
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field 
                                name="equipment_id" 
                                placeholder="Equipo a evaluar"
                                options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                            />
                        </h1>
                    </div>

                   <group>
                        <field name="rating_date"/>
                        <field name="rating"/>
                        <field name="active" />
                        <field name="evaluated_by_id" readonly="True"/>
                        <field name="is_recommended" readonly="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

